root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official

# ktlint_official の既定は 140。日本語は全角で幅を取るため、
# 文字数が同じでも見た目はかなり長くなる。少し狭めに取る
max_line_length = 120

# 引数が 2 個以上の関数は、行長に収まっていても複数行に展開する。
# 引数を足したときに 1 行だけの差分になり、レビューで何が増えたか分かるため。
# ktlint_official の既定と同じ設定。
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2

# Composable は大文字始まりが Compose の慣習なので function-naming の対象から外す。
# テスト名はバッククォート付きの日本語で書く決まり（AGENTS.md）で、
# テストのソースセットでは既定で無効になるが、判定に失敗した場合に備えて明示しておく
ktlint_function_naming_ignore_when_annotated_with = Composable, Test

# 複数行の本体は {} で囲む。ktlint の既定は 1 つの式なら式本体に寄せるので外す
ktlint_standard_function-expression-body = disabled

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
