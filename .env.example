# docker compose 用の設定。cp .env.example .env して書き換える。

# 公開するドメイン。WebFinger の acct とアクターの id に使う。
# アクター ID に焼き込まれて後から変えられないので、本番では慎重に決めること。
DOMAIN=example.com

# アクターのユーザー名。Mastodon から @admin@<DOMAIN> で検索できるようになる。
# 変えると別人のアカウントとして扱われ、既存のフォロワーは付いてこない。
# ACTOR_USERNAME=admin

# ホスト側で公開するポート。コンテナ内は常に 8080。
PUBLISH_PORT=8080

# 管理画面などの静的ファイルを置いたホスト側のディレクトリ。
# :frontend の成果物（frontend/build/dist/wasmJs/productionExecutable）を指す。
# 使う場合は docker-compose.yml の STATIC_SRC_DIR と volumes のコメントも外すこと。
# 何も設定しなければ画面は配信されない（/ は 404 になる）。
# STATIC_SRC_DIR=./frontend/build/dist/wasmJs/productionExecutable

# アクターの秘密鍵を外から渡す場合だけ設定する。
# 既定ではボリュームの中（/data/actor-private-key.pem）に生成されるので、
# 通常は設定不要。使う場合は docker-compose.yml の
# ACTOR_PRIVATE_KEY_PATH を消してから、PEM 全体を 1 行にせず入れること。
# ACTOR_PRIVATE_KEY_PEM=
