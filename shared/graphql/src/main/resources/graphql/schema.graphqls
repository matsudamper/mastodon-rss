type Query {
    admin: AdminQuery!
}

type Mutation {
    admin: AdminMutation!
}

type AdminQuery {
    session: AdminSession!
}

type AdminMutation {
    "通るとセッションの Cookie が返る"
    login(password: String!): AdminLoginResult!

    "サーバー側のセッションも消える"
    logout: AdminSession!
}

type AdminSession {
    loggedIn: Boolean!

    "サーバーに ADMIN_PASSWORD_HASH が設定されているか"
    passwordConfigured: Boolean!
}

type AdminLoginResult {
    session: AdminSession!
    failure: AdminLoginFailure
}

enum AdminLoginFailure {
    WRONG_PASSWORD

    "ADMIN_PASSWORD_HASH が未設定"
    NOT_CONFIGURED
}
