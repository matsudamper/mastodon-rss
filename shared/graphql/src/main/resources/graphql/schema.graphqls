"問い合わせ。管理用は admin の下にまとめる"
type Query {
    """
    管理画面から引くもの。

    認可はエンドポイントではなくフィールドごとに見る。この下は session を除いて
    ログインしている人だけが引ける。
    """
    admin: AdminQuery!
}

"更新。管理用は admin の下にまとめる"
type Mutation {
    admin: AdminMutation!
}

type AdminQuery {
    """
    いまログインしているか。

    ログインしていなくても引ける。画面はこれを見てログインの入力を出すかどうかを決める。
    """
    session: AdminSession!
}

type AdminMutation {
    """
    パスワードを送ってログインする。

    ログインの口なので、これだけは認証を要求しない。通るとセッションの Cookie が返り、
    以降のリクエストにブラウザが付ける。
    """
    login(password: String!): AdminLoginResult!

    "ログアウトする。サーバー側のセッションも消える"
    logout: AdminSession!
}

type AdminSession {
    "ログインしているか"
    loggedIn: Boolean!

    """
    サーバーに ADMIN_PASSWORD_HASH が設定されているか。

    未設定の間はログインする手段が無い。パスワードが違うのとは分けて扱えるように、
    セッションと一緒に返す。
    """
    passwordConfigured: Boolean!
}

type AdminLoginResult {
    "送った後の状態。通っていれば loggedIn が true になる"
    session: AdminSession!

    "通らなかった理由。通ったときは null"
    failure: AdminLoginFailure
}

enum AdminLoginFailure {
    "パスワードが違う。入れ直せば通る"
    WRONG_PASSWORD

    "ADMIN_PASSWORD_HASH が未設定。入れ直しても通らない"
    NOT_CONFIGURED
}
