type AdminMutation {
    "通るとセッションの Cookie が返る"
    login(password: String!): AdminLoginResult!

    "サーバー側のセッションも消える"
    logout: AdminSession!
}

type AdminLoginResult {
    session: AdminSession!
    failure: AdminLoginFailure
}

enum AdminLoginFailure {
    WRONG_PASSWORD

    "ADMIN_PASSWORD_HASH が未設定"
    NOT_CONFIGURED
}
