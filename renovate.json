{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "JetBrains Compose Gradle プラグインと BOM 由来の org.jetbrains.compose 依存を同一 PR にまとめる",
      "groupName": "jetbrains-compose-plugin",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "org.jetbrains.compose",
        "/^org\\.jetbrains\\.compose:/",
        "!/^org\\.jetbrains\\.compose\\.ui:/"
      ]
    },
    {
      "description": "org.jetbrains.compose.ui ライブラリは Gradle プラグインとは別 PR で更新する",
      "groupName": "jetbrains-compose-libraries",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["/^org\\.jetbrains\\.compose\\.ui:/"]
    },
    {
      "description": "OpenTelemetry SDK・incubator・instrumentation を同一 PR で更新する",
      "groupName": "opentelemetry",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "/^io\\.opentelemetry/",
        "/^io\\.opentelemetry\\.instrumentation/"
      ]
    },
    {
      "description": "libs.versions.toml の OpenTelemetry 用 version ref を同一 PR で更新する",
      "groupName": "opentelemetry",
      "matchManagers": ["gradle"],
      "matchDepNames": [
        "opentelemetry",
        "opentelemetryApiIncubator",
        "opentelemetryInstrumentation"
      ]
    },
    {
      "description": "指定した GitHub Actions を自動マージする",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "/^actions\\//",
        "gradle/actions"
      ],
      "automerge": true
    },
    {
      "description": "指定した Gradle 依存を自動マージする",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "com.android.kotlin.multiplatform.library",
        "/^io\\.coil-kt\\.coil3:/",
        "/^io\\.ktor:/",
        "/^org\\.graalvm\\.buildtools(?:\\.native|:)/",
        "org.graalvm.sdk:nativeimage",
        "/^org\\.jetbrains\\.kotlinx:/"
      ],
      "automerge": true
    }
  ]
}
