{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "OpenTelemetry SDK・incubator・instrumentation を同一 PR で更新する",
      "groupName": "opentelemetry",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "/^io\\.opentelemetry/",
        "/^io\\.opentelemetry\\.instrumentation/"
      ]
    },
    {
      "description": "libs.versions.toml の OpenTelemetry 用 version ref を同一 PR で更新する",
      "groupName": "opentelemetry",
      "matchManagers": ["gradle"],
      "matchDepNames": [
        "opentelemetry",
        "opentelemetryApiIncubator",
        "opentelemetryInstrumentation"
      ]
    },
    {
      "description": "actions/ 配下の GitHub Actions を自動マージする",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/^actions\\//"],
      "automerge": true
    },
    {
      "description": "指定した Gradle 依存を自動マージする",
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "com.android.kotlin.multiplatform.library",
        "/^io\\.coil-kt\\.coil3:/",
        "/^io\\.ktor:/",
        "/^org\\.graalvm\\.buildtools(?:\\.native|:)/"
      ],
      "automerge": true
    }
  ]
}
