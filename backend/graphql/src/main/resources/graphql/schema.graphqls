schema {
    query: Query
    mutation: Mutation
}

type Query {
    admin: AdminQuery!

    "公開アカウントの一覧。limit は 100 までで、超えた指定は 100 に丸める"
    accounts(cursor: String, limit: Int!): AccountsConnection! @lazy
    account(username: String!): Account @lazy
}

type Mutation {
    admin: AdminMutation!
}

type AccountsConnection {
    nodes: [Account!]!
    pageInfo: PageInfo!
}

type PageInfo {
    hasMore: Boolean!
    nextCursor: String
}
