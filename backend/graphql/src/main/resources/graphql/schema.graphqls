schema {
    query: Query
    mutation: Mutation
}

type Query {
    admin: AdminQuery!

    "公開アカウントの一覧。続きを引くときは 1 ページ目と同じ order を渡す"
    accounts(cursor: String, limit: Int!, order: AccountsOrder!): AccountsConnection! @lazy
    account(username: String!): Account @lazy

    "アカウントが配信した投稿。新しい順"
    notes(query: AccountNotesQuery!): AccountNotesConnection! @lazy

    "全アカウントが配信した投稿。新しい順"
    timeline(query: TimelineQuery!): AccountNotesConnection! @lazy

    "アカウントのフォロワー。アクター URL 順。応答しない名前なら null"
    followers(query: AccountFollowersQuery!): AccountFollowersConnection @lazy

    "アカウントが配信した投稿 1 件"
    note(username: String!, id: PublicNoteId!): AccountNote
}

type Mutation {
    admin: AdminMutation!
}

enum AccountsOrder {
    "追加した順。新しいものが先"
    ADDED_NEWEST

    "最後に投稿した順。新しいものが先。投稿の無いアカウントは後ろ"
    LATEST_NOTE
}

type AccountsConnection {
    nodes: [Account!]!
    pageInfo: PageInfo!
}

type PageInfo {
    hasMore: Boolean!
    nextCursor: String
}
