type AdminMutation {
    "通るとセッションの Cookie が返る"
    login(password: String!): AdminLoginResult! @lazy

    "サーバー側のセッションも消える"
    logout: AdminSession! @lazy

    "アカウントを追加する"
    addAccount(username: String!): AdminAddAccountResult! @lazy

    "アカウントとして投稿し、フォロワーに配る"
    postNote(username: String!, body: String!): AdminPostNoteResult! @lazy

    "RSS フィードを登録する"
    saveFeed(saveFeedQuery: SaveFeedQuery!): AdminSaveFeedResult! @lazy

    "フィードの最新を取り込み、未投稿の記事を投稿する"
    postFeedItems(query: PostFeedItemsQuery!): AdminPostFeedItemsResult! @lazy

    "取り込んだ記事を消す。配信した投稿は消されない。"
    deleteFeedItems(query: DeleteFeedItemsQuery!): AdminDeleteFeedItemsResult! @lazy

    "投稿を 1 件消す。元になった記事は消されない。"
    deleteNote(query: DeleteNoteQuery!): AdminDeleteNoteResult! @lazy
}

input DeleteNoteQuery {
    "投稿したアカウント"
    username: String!
    noteId: PublicNoteId!
}

type AdminDeleteNoteResult {
    "消せた投稿の id"
    deletedId: PublicNoteId

    failure: AdminDeleteNoteFailure
}

type AdminDeleteNoteFailure {
    reason: AdminDeleteNoteFailureReason!
}

enum AdminDeleteNoteFailureReason {
    UNKNOWN_ACCOUNT

    "そのアカウントの投稿に無い"
    NOT_FOUND
}

type AdminPostNoteResult {
    "配信できたかに関わらず、記録できていれば入る"
    note: AdminNote

    "送った宛先の数。sharedInbox でまとまるのでフォロワーの数とは一致しない"
    deliveryTargets: Int

    "そのうち相手が受け取った数。宛先より少なければ届かなかったものがある"
    delivered: Int

    "投稿できなかった場合だけ入る"
    failure: AdminPostNoteFailure
}

type AdminPostNoteFailure {
    "その名前のアカウントが無い"
    unknownAccount: Boolean!

    "本文が空"
    isEmpty: Boolean!

    "文字数の上限を超えている場合の上限"
    maxLength: Int
}

type AdminLoginResult {
    session: AdminSession!
    failure: AdminLoginFailure
}

enum AdminLoginFailure {
    WRONG_PASSWORD

    "ADMIN_PASSWORD_HASH が未設定"
    NOT_CONFIGURED
}

type AdminAddAccountResult {
    adminAccount: AdminAccount

    "追加できなかった場合だけ入る"
    failure: AdminAddAccountFailure
}

type AdminAddAccountFailure {
    "入力にあった使えない文字"
    unusableCharacters: [String!]

    "使える文字数の上限を超えている場合の上限"
    maxLength: Int

    "使える文字数の下限に足りない場合の下限"
    minLength: Int

    "同じ名前のアカウントが既にある"
    isDuplicated: Boolean!
}
