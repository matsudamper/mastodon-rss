type AdminQuery {
    session: AdminSession! @lazy

    "応答するアカウントの一覧。追加した順。limit を渡さないと 10 件、上限は 50 件"
    adminAccounts(cursor: String, limit: Int): AdminAccountsConnection! @lazy

    "アカウント 1 つ。応答しない名前なら null"
    adminAccount(username: String!): AdminAccount @lazy

    "アカウントが配信した投稿。新しい順"
    notes(username: String!, cursor: String, limit: Int!): AdminNotesConnection! @lazy

    "RSS フィードを取得してパース結果を返す。"
    previewFeed(url: String!): AdminFeedPreviewResult! @lazy

    "未投稿の記事を返す"
    unpublishedFeedItems(query: UnpublishedFeedItemsQuery!): AdminUnpublishedFeedItemsResult! @lazy
}

type AdminAccountsConnection {
    nodes: [AdminAccount!]!
    pageInfo: PageInfo!
}

type AdminNotesConnection {
    nodes: [AdminNote!]!
    pageInfo: PageInfo!
}

"配信した投稿 1 件"
type AdminNote {
    id: PublicNoteId!

    "投稿の URL。相手はここをパーマリンクとして開く"
    url: String!

    "配信した本文の HTML"
    contentHtml: String!

    publishedAt: UnixTime!

    "この投稿の元になった取り込み済みの記事。手で書いた投稿と、記事を消した後は null"
    feedItem: AdminFeedItem @lazy
}

type AdminSession {
    loggedIn: Boolean!

    "サーバーに ADMIN_PASSWORD_HASH が設定されているか"
    passwordConfigured: Boolean!
}

type AdminAccount {
    account: Account!

    "管理画面から追加した時刻"
    createdAt: UnixTime!

    "Accept を返せたフォロワーの数"
    followerCount: Int! @lazy

    "登録済みの RSS フィード。未登録なら null"
    feed: Feed @lazy

    "このアカウントが署名する配信キューの件数"
    deliveryQueue: AdminDeliveryQueueCounts! @lazy

    "送り直しを待っている配信。次に送る時刻の順"
    retryingDeliveries(cursor: String, limit: Int!): AdminRetryingDeliveriesConnection! @lazy

    "諦めた配信。新しい順"
    failedDeliveries(cursor: String, limit: Int!): AdminFailedDeliveriesConnection! @lazy
}
