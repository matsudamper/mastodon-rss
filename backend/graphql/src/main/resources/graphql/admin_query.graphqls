type AdminQuery {
    session: AdminSession! @lazy

    "応答するアカウントの一覧"
    accounts: [AdminAccount!]! @lazy

    """
    アカウントが配信した投稿。新しい順。

    位置は cursor で指す。件数で指すと、読んでいる間に投稿が増えたときに
    同じものが 2 回出たり抜けたりする。
    """
    notes(username: String!, cursor: String, limit: Int): AdminNotes! @lazy
}

type AdminNotes {
    items: [AdminNote!]!

    "次のページを取るときに渡す。null なら最後のページ"
    cursor: String
}

"配信した投稿 1 件"
type AdminNote {
    "投稿の URL。相手はここをパーマリンクとして開く"
    url: String!

    "配信した本文の HTML"
    contentHtml: String!

    publishedAt: UnixTime!
}

type AdminSession {
    loggedIn: Boolean!

    "サーバーに ADMIN_PASSWORD_HASH が設定されているか"
    passwordConfigured: Boolean!
}

type AdminAccount {
    "acct とパスに入る名前"
    username: String!

    "Mastodon の検索窓に貼る形"
    acct: String!

    "Actor の URL"
    actorUrl: String!

    "管理画面から削除できるか。サーバーの設定で決まっているものは消せない"
    deletable: Boolean!

    "管理画面から追加した時刻。追加したものにだけ入る"
    createdAt: UnixTime
}
