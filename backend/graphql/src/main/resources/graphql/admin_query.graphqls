type AdminQuery {
    session: AdminSession! @lazy

    "応答するアカウントの一覧"
    adminAccounts: [AdminAccount!]! @lazy
}

type AdminSession {
    loggedIn: Boolean!

    "サーバーに ADMIN_PASSWORD_HASH が設定されているか"
    passwordConfigured: Boolean!
}

type AdminAccount {
    account: Account!

    "管理画面から削除できるか。サーバーの設定で決まっているものは消せない"
    deletable: Boolean!

    "管理画面から追加した時刻。追加したものにだけ入る"
    createdAt: UnixTime
}
