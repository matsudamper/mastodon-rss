type AdminFeedPreview {
    title: String
    siteUrl: String
    format: String!
    description: String
    itemCount: Int!
    sampleItems: [AdminFeedPreviewItem!]!
}

type AdminFeedPreviewItem {
    title: String
    link: String
    publishedAt: UnixTime
}

type AdminFeedPreviewResult {
    preview: AdminFeedPreview
    failure: AdminFeedPreviewFailure
}

type AdminFeedPreviewFailure {
    reason: AdminFeedPreviewFailureReason!
}

enum AdminFeedPreviewFailureReason {
    INVALID_URL
    FETCH_FAILED
    PARSE_FAILED
}

input SaveFeedQuery {
    accountId: AccountId!
    url: String!
}

type AdminSaveFeedResult {
    feed: Feed
    failure: AdminSaveFeedFailure
}

type AdminSaveFeedFailure {
    reason: AdminSaveFeedFailureReason!
}

enum AdminSaveFeedFailureReason {
    UNKNOWN_ACCOUNT
    DUPLICATE_URL
    ALREADY_HAS_FEED
    INVALID_URL
    FETCH_FAILED
    PARSE_FAILED
}

input UnpublishedFeedItemsQuery {
    "未投稿を返す対象のアカウント"
    accountId: AccountId!
}

type AdminUnpublishedFeedItem {
    title: String
    link: String
    publishedAt: UnixTime
}

type AdminUnpublishedFeedItemsResult {
    items: [AdminUnpublishedFeedItem!]
    failure: AdminUnpublishedFeedItemsFailure
}

type AdminUnpublishedFeedItemsFailure {
    reason: AdminUnpublishedFeedItemsFailureReason!
}

enum AdminUnpublishedFeedItemsFailureReason {
    UNKNOWN_ACCOUNT
    NO_FEED
}

input PostFeedItemsQuery {
    "未投稿を投稿する対象のアカウント"
    accountId: AccountId!
}

type AdminPostFeedItemsResult {
    "投稿できた記事"
    items: [AdminUnpublishedFeedItem!]
    failure: AdminPostFeedItemsFailure
}

type AdminPostFeedItemsFailure {
    reason: AdminPostFeedItemsFailureReason!
}

enum AdminPostFeedItemsFailureReason {
    UNKNOWN_ACCOUNT
    NO_FEED
    INVALID_URL
    FETCH_FAILED
    PARSE_FAILED
}

"取り込んだ記事 1 件"
type AdminFeedItem {
    title: String
    link: String

    "配信元が名乗っている公開日時。持たないフィードがある"
    publishedAt: UnixTime
}
