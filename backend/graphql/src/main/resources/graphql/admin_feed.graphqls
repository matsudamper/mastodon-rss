type AdminFeedPreview {
    title: String
    siteUrl: String
    format: String!
    description: String
    itemCount: Int!
    sampleItems: [AdminFeedPreviewItem!]!
}

type AdminFeedPreviewItem {
    title: String
    link: String
    publishedAt: UnixTime
}

type AdminFeedPreviewResult {
    preview: AdminFeedPreview
    failure: AdminFeedPreviewFailure
}

type AdminFeedPreviewFailure {
    reason: AdminFeedPreviewFailureReason!
}

enum AdminFeedPreviewFailureReason {
    INVALID_URL
    FETCH_FAILED
    PARSE_FAILED
}

input SaveFeedQuery {
    accountId: AccountId!
    url: String!
    "true なら取得時点の記事も投稿する"
    postExistingItems: Boolean! = false
}

type AdminSaveFeedResult {
    feed: Feed
    "投稿できた件数。選ばなければ 0"
    postedCount: Int
    "投稿しなかった件数"
    skippedCount: Int
    failure: AdminSaveFeedFailure
}

type AdminSaveFeedFailure {
    reason: AdminSaveFeedFailureReason!
}

enum AdminSaveFeedFailureReason {
    UNKNOWN_ACCOUNT
    DUPLICATE_URL
    ALREADY_HAS_FEED
    INVALID_URL
    FETCH_FAILED
    PARSE_FAILED
}
