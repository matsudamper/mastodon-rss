type Account {
    id: AccountId!

    username: String!

    "Mastodon の検索窓に貼る形"
    acct: String!

    actorUrl: String!

    "プロフィールの表示名。未設定なら空文字"
    displayName: String!

    "プロフィールの説明文。未設定なら空文字"
    summary: String!

    "プロフィール画像の URL。無ければnull"
    iconUrl: String @lazy

    "プロフィールヘッダー画像の URL。無ければnull"
    headerUrl: String @lazy

    "Accept を返せたフォロワーの数"
    followerCount: Int! @lazy

    "配信した投稿の数"
    noteCount: Int! @lazy

    "登録済みの RSS フィード。未登録なら null"
    feed: Feed @lazy
}

input AccountFollowersQuery {
    username: String!
    cursor: String
    limit: Int!
}

type AccountFollowersConnection {
    nodes: [AccountFollower!]!
    pageInfo: PageInfo!
}

"このアカウントをフォローしている相手 1 人"
type AccountFollower {
    "相手のプロフィールの URL。名乗っていなければアクター文書の URL"
    url: String!

    "Mastodon の検索窓に貼る形。相手が名前を名乗っていなければ null"
    acct: String

    "プロフィールの表示名。名乗っていなければ null"
    displayName: String

    "プロフィール画像の URL。無ければ null"
    iconUrl: String
}
