type Account {
    id: AccountId!

    username: String!

    "Mastodon の検索窓に貼る形"
    acct: String!

    actorUrl: String!

    "プロフィールの表示名。未設定なら空文字"
    displayName: String!

    "プロフィールの説明文。未設定なら空文字"
    summary: String!

    "プロフィール画像の URL。無ければnull"
    iconUrl: String @lazy

    "Accept を返せたフォロワーの数"
    followerCount: Int! @lazy

    "配信した投稿の数"
    noteCount: Int! @lazy

    "登録済みの RSS フィード。未登録なら null"
    feed: Feed @lazy
}

input AccountFollowersQuery {
    username: String!
    cursor: String
    limit: Int!
}

type AccountFollowersConnection {
    nodes: [AccountFollower!]!
    pageInfo: PageInfo!
}

"このアカウントをフォローしている相手 1 人"
type AccountFollower {
    "相手のプロフィールの URL。相手が持たない場合はアクター文書の URL を返す"
    url: String!

    "Mastodon の検索窓に貼る @name@host の形。名前を保存する前から居るフォロワーは「未取得」を返す"
    acct: String!
}
