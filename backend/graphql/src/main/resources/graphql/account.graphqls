type Account {
    id: AccountId!

    username: String!

    "Mastodon の検索窓に貼る形"
    acct: String!

    actorUrl: String!

    "プロフィールの表示名。未設定なら null で、相手にはユーザー名が出る"
    displayName: String

    "プロフィールの説明文。未設定なら null で、相手には既定の文言が出る"
    summary: String

    "Accept を返せたフォロワーの数"
    followerCount: Int! @lazy

    "配信した投稿の数"
    noteCount: Int! @lazy

    "登録済みの RSS フィード。未登録なら null"
    feed: Feed @lazy
}

"プロフィールに入れられる文字数。数え方はコードポイント"
type AccountProfileLimits {
    displayNameMaxLength: Int!

    summaryMaxLength: Int!
}
