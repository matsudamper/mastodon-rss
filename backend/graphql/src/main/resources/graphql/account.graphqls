type Account {
    id: AccountId!

    username: String!

    "Mastodon の検索窓に貼る形"
    acct: String!

    actorUrl: String!

    "プロフィールの表示名。未設定なら空文字"
    displayName: String!

    "プロフィールの説明文。未設定なら空文字"
    summary: String!

    "Accept を返せたフォロワーの数"
    followerCount: Int! @lazy

    "配信した投稿の数"
    noteCount: Int! @lazy

    "登録済みの RSS フィード。未登録なら null"
    feed: Feed @lazy
}
