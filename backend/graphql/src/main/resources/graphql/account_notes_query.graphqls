input AccountNotesQuery {
    username: String!
    cursor: String
    limit: Int!
}

type AccountNotesConnection {
    nodes: [AccountNote!]!
    pageInfo: PageInfo!
}

"配信した投稿 1 件"
type AccountNote {
    id: PublicNoteId!

    "投稿の URL。相手はここをパーマリンクとして開く"
    url: String! @lazy

    "配信した本文の HTML"
    contentHtml: String! @lazy

    publishedAt: UnixTime! @lazy

    "お気に入りの数"
    favouriteCount: Int! @lazy

    "スタンプの種類ごとの数。多い順"
    stamps: [NoteStamp!]! @lazy

    "配信したアカウント"
    account: Account! @lazy

    "本文にあるリンク。本文に出てくる順で、linkPreviews と同じ並び。取りに行かないので速い"
    linkUrls: [String!]! @lazy

    "本文にあるリンクごとの OGP。本文に出てくる順"
    linkPreviews: [LinkPreview!]! @lazy
}

"投稿に押されたスタンプ 1 種類"
type NoteStamp {
    "絵文字そのもの、またはカスタム絵文字の名前"
    name: String!

    "カスタム絵文字の画像 URL。絵文字そのものなら null"
    imageUrl: String

    "押された数"
    count: Int!
}
