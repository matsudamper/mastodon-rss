"配信キューのうち、このアカウントが署名する分の件数"
type AdminDeliveryQueueCounts {
    "送る時刻を待っているものと、送っている最中のものの合計"
    waitingCount: Int!

    "諦めたもの。行は消えないので増え続ける"
    failedCount: Int!
}

"配信が何を送るものか"
enum AdminDeliveryKind {
    "投稿を包んだ Create"
    CREATE_NOTE

    "消した投稿の Delete"
    DELETE_NOTE

    "受け取った Follow への Accept"
    ACCEPT_FOLLOW

    "アクター情報の Update"
    UPDATE_ACTOR

    "消したアクターの Delete"
    DELETE_ACTOR
}

type AdminUnsentDeliveriesConnection {
    nodes: [AdminUnsentDelivery!]!
    pageInfo: PageInfo!
}

"まだ送り終えていない配信 1 件"
type AdminUnsentDelivery {
    "何を送る配信か"
    kind: AdminDeliveryKind!

    "署名するこちらのアカウントの名前"
    username: String!

    "宛先の inbox"
    inbox: String!

    "送ろうとした回数"
    attempts: Int!

    "次に送る時刻"
    nextAttemptAt: UnixTime!

    "いま送っている最中か"
    sending: Boolean!

    "最後に送れなかった理由。まだ一度も送っていなければ null"
    lastError: String
}

type AdminRetryingDeliveriesConnection {
    nodes: [AdminRetryingDelivery!]!
    pageInfo: PageInfo!
}

"一度は送れず、送り直しを待っている配信 1 件"
type AdminRetryingDelivery {
    "何を送る配信か"
    kind: AdminDeliveryKind!

    "宛先の inbox"
    inbox: String!

    "送ろうとした回数"
    attempts: Int!

    "次に送る時刻"
    nextAttemptAt: UnixTime!

    "最後に送れなかった理由"
    lastError: String
}

type AdminFailedDeliveriesConnection {
    nodes: [AdminFailedDelivery!]!
    pageInfo: PageInfo!
}

"諦めた配信 1 件。もう送らない"
type AdminFailedDelivery {
    "何を送る配信か"
    kind: AdminDeliveryKind!

    "宛先の inbox"
    inbox: String!

    "送ろうとした回数"
    attempts: Int!

    "最後に送れなかった理由"
    lastError: String
}
